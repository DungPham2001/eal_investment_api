NODE_ENV=development
PORT=4000
# MongoDB Atlas (same cluster as the other EAL apps, one database per app). Local dev: mongodb://127.0.0.1:27017/eal_investment
# Transactions (cascade delete, renew, bulk delete) need a replica set: Atlas has one. On a standalone mongod they run without a transaction.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.nd2qnwn.mongodb.net/eal_investment?retryWrites=true&w=majority
# Comma separated. Mobile apps do not send Origin, so this only matters for web clients / an admin site.
CORS_ORIGINS=http://localhost:3000

# Business timezone: "today", day 5 of the month, start of month, closed periods (spec section 10.6).
TIMEZONE=America/New_York
# Records of rents / expenses / revenue older than the first day of (current month - LOCK_MONTHS) are locked.
LOCK_MONTHS=3

# Optional. When set, every /v1 request must send `Authorization: Bearer <API_KEY>` (or `X-Api-Key`).
API_KEY=
# Optional. Required (X-Admin-Key) for PUT /v1/content/:key and PUT /v1/config/closed-before. Empty = those endpoints are disabled.
ADMIN_KEY=
# Optional. Vercel Cron sends `Authorization: Bearer <CRON_SECRET>` to /v1/jobs/daily.
CRON_SECRET=
MIN_APP_VERSION=1.0.0
